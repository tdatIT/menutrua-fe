# Rendered by the nginx image entrypoint (envsubst) into conf.d/default.conf.
# Only defined env vars are substituted: ${API_UPSTREAM}, ${NGINX_LOCAL_RESOLVERS}.

server {
    listen       8080;
    listen  [::]:8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;
    charset utf-8;
    client_max_body_size 5m;

    # ---------------------------------------------------------------- compression
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json image/svg+xml application/manifest+json;

    include /etc/nginx/snippets/security-headers.conf;

    # ------------------------------------------------------------------ healthz
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # -------------------------------------------------------------- API proxy
    # Same-origin /api keeps the httpOnly refresh cookie first-party
    # (SameSite=Strict). The upstream is a variable so nginx resolves it per
    # request and still boots when the backend is not up yet.
    location /api/ {
        resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass         $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 30s;
    }

    # ---------------------------------------------------- hashed build assets
    # Vite fingerprints everything in /assets, so it can be cached forever.
    location /assets/ {
        expires max;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
        access_log off;
    }

    # MSW worker (development image only) must never be cached.
    location = /mockServiceWorker.js {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # ------------------------------------------------------------ SPA fallback
    # Any unknown path renders index.html; React Router takes it from there.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The shell must always be revalidated so new deploys are picked up.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Never serve dotfiles / source maps in production.
    location ~ /\.(?!well-known) { deny all; }
    location ~* \.map$ { deny all; }
}
