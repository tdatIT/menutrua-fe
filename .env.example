# Copy to .env.local (git-ignored) to override values for your machine.
# Full reference: .env.development and .env.production

VITE_APP_NAME=MenuTrua
VITE_APP_ENV=development
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
VITE_ENABLE_MOCK=true
VITE_AUTH_REFRESH_STRATEGY=body
VITE_AUTH_REFRESH_LEEWAY=10
VITE_MOCK_ACCESS_TOKEN_TTL=60
VITE_MOCK_REFRESH_TOKEN_TTL=604800
VITE_MOCK_LATENCY_MS=400
DEV_API_PROXY_TARGET=http://localhost:8080
