# ---------------------------------------------------------------------------
# Production environment — loaded by `bun run build` / `vite build --mode production`
# Values are baked into the static bundle at build time.
# Never put secrets here: everything VITE_* ends up in public JS.
# ---------------------------------------------------------------------------

VITE_APP_NAME=MenuTrua
VITE_APP_ENV=production

# Same-origin by default: nginx forwards /api to the backend (see docker/nginx).
# Use an absolute URL (https://api.menutrua.vn) if the API lives on another origin.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# Mock backend is excluded from the production bundle when false.
VITE_ENABLE_MOCK=false

# Recommended: backend issues the refresh token as an httpOnly, Secure,
# SameSite=Strict cookie scoped to /api/auth.
VITE_AUTH_REFRESH_STRATEGY=cookie
VITE_AUTH_REFRESH_LEEWAY=30
