# ---------------------------------------------------------------------------
# Development environment — loaded by `bun run dev` / `vite --mode development`
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here: everything VITE_* ends up in public JS.
# ---------------------------------------------------------------------------

VITE_APP_NAME=MenuTrua
VITE_APP_ENV=development

# Base URL of the backend API. Relative paths keep requests same-origin
# (Vite proxy in dev, nginx in Docker), which lets the BE use httpOnly cookies.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000

# true  -> MSW intercepts every /api call with the mock backend in src/mocks
# false -> requests hit the real backend at VITE_API_BASE_URL
VITE_ENABLE_MOCK=true

# How the refresh token travels:
#   cookie -> BE sets an httpOnly cookie, FE never sees the refresh token (recommended)
#   body   -> FE stores the refresh token and sends it in the /auth/refresh body
VITE_AUTH_REFRESH_STRATEGY=body

# Refresh the access token this many seconds before it expires.
VITE_AUTH_REFRESH_LEEWAY=10

# Mock-only: lifetime of mocked tokens (seconds). Short on purpose so the
# auto-refresh flow is easy to observe in DevTools.
VITE_MOCK_ACCESS_TOKEN_TTL=60
VITE_MOCK_REFRESH_TOKEN_TTL=604800
VITE_MOCK_LATENCY_MS=400

# Dev server only (not exposed to the bundle): real backend for the /api proxy
# when VITE_ENABLE_MOCK=false.
DEV_API_PROXY_TARGET=http://localhost:8080
